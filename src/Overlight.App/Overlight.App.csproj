<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Overlight.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <!--
      Without this, `dotnet run`/`dotnet build` invoked directly on this
      .csproj (bypassing Overlight.sln's Debug|x64 configuration mapping)
      default MSBuild's Platform to AnyCPU, which
      WindowsAppSDKSelfContained explicitly rejects ("The platform
      'AnyCPU' is not supported for Self Contained mode"). Pinning it
      here makes `dotnet run --project src\Overlight.App\Overlight.App.csproj`
      work without needing an explicit -p:Platform=x64 every time.
    -->
    <Platform>x64</Platform>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <!--
      Deliberately NOT referencing Microsoft.Web.WebView2 here.
      Microsoft.WindowsAppSDK already bundles its own copy of the
      WebView2 Core API surface inside Microsoft.WinUI.dll (needed
      internally for the <WebView2/> XAML control), so adding that
      package too gives two copies of CoreWebView2 and friends and
      fails with CS0433 "exists in both ... Microsoft.WinUI". The
      Microsoft.Web.WebView2.Core types TerminalHostControl.xaml.cs
      uses come from WindowsAppSDK above, no separate package needed.
    -->
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      xterm.js + xterm-addon-fit (vendored, MIT-licensed, see
      Terminal/WebAssets/vendor/*/LICENSE) and the bridge page that
      loads them — copied next to the built exe so
      TerminalHostControl's SetVirtualHostNameToFolderMapping can find
      them at AppContext.BaseDirectory/Terminal/WebAssets.
    -->
    <Content Include="Terminal\WebAssets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
