<Window
    x:Class="Overlight.App.Terminal.TerminalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Overlight.App.Terminal.Models"
    xmlns:local="using:Overlight.App.Terminal">

    <Grid Background="#0C0C0C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: persistent "which account am I in" indicator -->
        <Grid Grid.Row="0" Background="#161616" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="OVERLIGHT TERMINAL"
                       FontFamily="Cascadia Mono"
                       Foreground="#7CFC91"
                       FontSize="14"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="●" Foreground="#7CFC91" FontFamily="Cascadia Mono" VerticalAlignment="Center" />
                <TextBlock x:Name="ActiveAccountText"
                           Text="no active account"
                           FontFamily="Cascadia Mono"
                           Foreground="#CCCCCC"
                           FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Body: a real terminal emulator on the left, loop + account panels on the right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!--
                xterm.js (vendored under WebAssets/vendor) rendering a
                real shell spawned over ConPTY — see TerminalHostControl
                and Pty/PseudoConsoleSession.cs. Keyboard focus here goes
                straight to the shell, not to Overlight's own commands.
            -->
            <local:TerminalHostControl Grid.Column="0" />

            <Grid Grid.Column="1" Padding="8" Background="#111111">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Function 1: timed loops with a countdown visualizer -->
                <TextBlock Grid.Row="0"
                           Text="LOOPS"
                           Foreground="#7CFC91"
                           FontFamily="Cascadia Mono"
                           FontSize="12"
                           Margin="4,0,0,6" />
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{x:Bind Loops}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TimedLoop">
                                <Border Background="#1B1B1B" CornerRadius="4" Margin="0,0,0,6" Padding="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Prompt}"
                                                   Foreground="#D4D4D4"
                                                   FontFamily="Cascadia Mono"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2" />
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}"
                                                     Maximum="1"
                                                     Foreground="#7CFC91"
                                                     Background="#333333"
                                                     Height="4" />
                                        <TextBlock Text="{x:Bind StatusLine, Mode=OneWay}"
                                                   Foreground="#888888"
                                                   FontFamily="Cascadia Mono"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Function 2: account switcher / active-account indicator -->
                <TextBlock Grid.Row="2"
                           Text="ACCOUNTS"
                           Foreground="#7CFC91"
                           FontFamily="Cascadia Mono"
                           FontSize="12"
                           Margin="4,12,0,6" />
                <ScrollViewer Grid.Row="3">
                    <ItemsControl ItemsSource="{x:Bind AccountRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:AccountRow">
                                <Button Click="OnAccountRowClicked"
                                        Tag="{x:Bind Label}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        Margin="0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Marker}" Foreground="#7CFC91" FontFamily="Cascadia Mono" Width="12" />
                                        <TextBlock Text="{x:Bind Label}" Foreground="#D4D4D4" FontFamily="Cascadia Mono" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Feedback strip for Overlight's own commands (loop/account), separate from shell output above -->
        <ListView x:Name="TranscriptList"
                  Grid.Row="2"
                  Height="90"
                  Background="#111111"
                  BorderThickness="0,1,0,0"
                  BorderBrush="#222222"
                  Padding="12,6"
                  ItemsSource="{x:Bind Transcript}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}"
                               FontFamily="Cascadia Mono"
                               Foreground="#888888"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Overlight's own command line: drives loops/accounts, not the shell above -->
        <Grid Grid.Row="3" Background="#161616" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="overlight&gt;"
                       Foreground="#7CFC91"
                       FontFamily="Cascadia Mono"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox x:Name="CommandInput"
                     Grid.Column="1"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#D4D4D4"
                     FontFamily="Cascadia Mono"
                     PlaceholderText="loop / account commands — type 'help'"
                     KeyDown="OnCommandInputKeyDown" />
        </Grid>
    </Grid>
</Window>
