<UserControl
    x:Class="Overlight.App.Terminal.TerminalHostControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#0C0C0C">
        <!--
            The <WebView2/> element is Microsoft.UI.Xaml.Controls.WebView2,
            and the CoreWebView2.* API used in the code-behind, both come
            from WindowsAppSDK (see the comment in Overlight.App.csproj —
            do NOT add the separate Microsoft.Web.WebView2 NuGet package,
            it collides with the copy WindowsAppSDK already ships). Also
            requires the WebView2 Runtime present on the machine
            (preinstalled on Windows 11; redistributable on Windows 10).
        -->
        <WebView2 x:Name="Browser" />
    </Grid>
</UserControl>
